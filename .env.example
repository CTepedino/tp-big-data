# Copiar a .env y completar con credenciales de AstraDB (no commitear .env)
CASSANDRA_KEYSPACE=cloud_analytics
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_SECURE_BUNDLE_PATH=/ruta/a/secure-connect-cloud-analytics.zip

# Alternativa: Cassandra local (sin bundle)
# CASSANDRA_CONTACT_POINTS=127.0.0.1
# CASSANDRA_USERNAME=cassandra
# CASSANDRA_PASSWORD=cassandra
